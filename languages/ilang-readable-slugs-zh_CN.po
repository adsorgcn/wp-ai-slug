#. Plugin URI of the plugin
#: ilang-readable-slugs.php
msgid "https://github.com/adsorgcn/wp-ai-slug"
msgstr ""

#. Description of the plugin
#: ilang-readable-slugs.php
msgid "Automatically turn non-English post titles into clean, readable English URL slugs using AI. Falls back to the WordPress default if generation fails, so publishing is never blocked. Works with any OpenAI-compatible endpoint."
msgstr "用 AI 把非英文标题变成干净好读的英文链接。生成失败自动回退 WordPress 默认行为,绝不阻塞发布。支持任何 OpenAI 兼容接口。"

#. Author of the plugin
#: ilang-readable-slugs.php
msgid "静水流深 (adsorgcn)"
msgstr ""

#. Author URI of the plugin
#: ilang-readable-slugs.php
msgid "https://github.com/adsorgcn"
msgstr ""

